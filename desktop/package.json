{
  "name": "nexoraosp-restaurant-desktop",
  "productName": "NEXORAOSP RESTAURANT",
  "version": "1.0.0",
  "private": true,
  "description": "NEXORAOSP RESTAURANT desktop staff console: the restaurant's order server and admin dashboard in one installable app, with all data stored on this machine.",
  "main": "main.cjs",
  "author": {
    "name": "NEXORAOSP RESTAURANT",
    "email": "admin@nexoraosp.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nexoraosp.restaurant",
    "productName": "NEXORAOSP RESTAURANT",
    "artifactName": "nexoraosp-restaurant-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*"
    ],
    "asar": false,
    "compression": "maximum",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXORAOSP RESTAURANT"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64"] }],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "maintainer": "NEXORAOSP RESTAURANT <admin@nexoraosp.com>",
      "synopsis": "Restaurant staff console: live orders, waiter calls and menu management",
      "icon": "build/icon.png"
    }
  }
}
