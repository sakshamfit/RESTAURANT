# ─────────────────────────────────────────────────────────────
# NEXORAOSP RESTAURANT — configuration
# No Supabase, no Firebase, no cloud services. The app is fully
# self-contained and needs only the admin password below.
#
# The optional backup cloud (bottom of this file) is never a service
# of ours: backups are written to the restaurant's OWN Google Drive /
# OneDrive / Dropbox account, with the restaurant's OWN OAuth client.
# Everything works with those variables left empty.
# ─────────────────────────────────────────────────────────────

# Single Admin Login
# ------------
# This is the ONE admin password. On the very first start the app
# saves it (hashed) to data/admin.json; after that the saved value
# is used, and you can change it from Admin → Café Settings →
# Update Password (takes effect immediately).
ADMIN_PASSWORD="9852120609@"
ADMIN_EMAIL="admin@nexoraosp.com"

# Optional: stable key for admin session tokens (min 16 chars). If
# empty, a key is derived automatically and sessions survive restarts.
ADMIN_SESSION_SECRET=""

# Persistence
# ------------
# Optional. If set, data is stored in your own PostgreSQL database.
# If unset (or unreachable), data is stored locally in
# data/restaurant.json — nothing external is required.
#   direct:     postgresql://postgres:PASSWORD@host:5432/restaurant
DATABASE_URL=""
DIRECT_URL=""

# APP_URL / PUBLIC_URL: Public URL where customers open QR codes.
# LEAVE EMPTY for auto-detect (uses LAN IP like http://192.168.1.42:3000).
# If QR codes show 127.0.0.1 and phones say "Safari can't connect", set this
# to your computer's LAN IP, e.g.:
#   APP_URL="http://192.168.1.42:3000"
# Or to a public domain / ngrok URL:
#   APP_URL="https://your-cafe.ngrok.io"
# You can also set it from Admin → Settings → QR Base URL (takes priority).
APP_URL=""
# Optional: same as APP_URL, for backwards compat
PUBLIC_URL=""
# Server bind — 0.0.0.0 lets phones on same Wi-Fi reach the server
HOST="0.0.0.0"
PORT="3000"

# License / subscription (only for distributed builds)
# ------------
# Leave LICENSE_REQUIRED unset (or set to "false") for self-hosted /
# dev builds. Set to "true" when building the installer customers
# download from your site — the app will then refuse to load the
# admin console until the customer enters a valid license key.
#
# LICENSE_API_BASE — your central license server URL. The desktop
# app calls this on first activation and on every heartbeat.
#
# LICENSE_SIGNING_SECRET — the HS256 secret used to sign license
# JWTs. In production set this to a long random string in your
# license server's env. The desktop app ALSO needs to know the
# same secret (because it verifies the JWT offline) — bake it
# into the desktop build at build time via this env var.
#
# LICENSE_ALLOW_SELF_ISSUE — set to "true" only for self-hosted
# builds (so the user can mint their own key without contacting
# your server). MUST be "false" in distributed builds.
LICENSE_REQUIRED=""
LICENSE_API_BASE="https://license.nexoraosp.com"
LICENSE_SIGNING_SECRET=""
LICENSE_ALLOW_SELF_ISSUE=""

# LICENSE_TRIAL_DAYS — auto-mint a free trial of N days on first
# launch of a distributed build. Set to 0 to disable the trial
# (customers must enter a key immediately).
LICENSE_TRIAL_DAYS="14"

# Optional WhatsApp notification gateway. Orders are recorded even if omitted.
WHATSAPP_PHONE_NUMBER="+919876543210"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Backup & disaster recovery (all optional)
# ------------
# Backups are ALWAYS written to this computer first, into the OS
# application-data folder (see docs/BACKUP.md). Nothing below is needed
# for that. These variables only let the app copy verified backups into
# the restaurant's own cloud storage account, using an OAuth client the
# restaurant owns — this software never stores a customer's backup and
# never pays for anyone's storage.
#
# Create your own app in each provider's console (docs/BACKUP.md has the
# exact redirect URI) and paste the identifiers here. Secrets stay on this
# machine: they are read from the environment at runtime and are never
# written into data/ or into a log.
#
# Google Drive — Google Cloud Console → OAuth client ID (Desktop app)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OneDrive / SharePoint personal — Microsoft Entra ID → App registration
# (mobile & desktop platform). A client secret is NOT required: PKCE.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Dropbox — App Console → Dropbox API app with app-folder access
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""

# Where verified backups are kept on this computer. Empty = the OS
# application-data folder (outside the install folder, so updates cannot
# delete your backups). Any absolute path works and is created if missing —
# e.g. a second drive:  BACKUP_DIR="/mnt/extra/restaurant-backups"
# (You can also pick a folder inside the app: Admin → Backup & Recovery →
# Automatic. A hosted/Vercel deployment can only write to /tmp, so there,
# rely on the customer's own cloud storage for the off-site copy.)
BACKUP_DIR=""
