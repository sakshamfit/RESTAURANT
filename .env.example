# ─────────────────────────────────────────────────────────────
# NEXORAOSP RESTAURANT — configuration
# No Supabase, no Firebase, no cloud services. The app is fully
# self-contained and needs only the admin password below.
# ─────────────────────────────────────────────────────────────

# Single Admin Login
# ------------
# This is the ONE admin password. On the very first start the app
# saves it (hashed) to data/admin.json; after that the saved value
# is used, and you can change it from Admin → Café Settings →
# Update Password (takes effect immediately).
ADMIN_PASSWORD="9852120609@"
ADMIN_EMAIL="admin@nexoraosp.com"

# Optional: stable key for admin session tokens (min 16 chars). If
# empty, a key is derived automatically and sessions survive restarts.
ADMIN_SESSION_SECRET=""

# Persistence
# ------------
# Optional. If set, data is stored in your own PostgreSQL database.
# If unset (or unreachable), data is stored locally in
# data/restaurant.json — nothing external is required.
#   direct:     postgresql://postgres:PASSWORD@host:5432/restaurant
DATABASE_URL=""
DIRECT_URL=""

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# License / subscription (only for distributed builds)
# ------------
# Leave LICENSE_REQUIRED unset (or set to "false") for self-hosted /
# dev builds. Set to "true" when building the installer customers
# download from your site — the app will then refuse to load the
# admin console until the customer enters a valid license key.
#
# LICENSE_API_BASE — your central license server URL. The desktop
# app calls this on first activation and on every heartbeat.
#
# LICENSE_PUBLIC_KEY — RSA public key (PEM) used by distributed
# builds to verify license JWTs offline. If unset, the build
# script uses license-keys/public.pem from the repo automatically.
# The matching LICENSE_PRIVATE_KEY lives ONLY on the license
# server (Vercel) — never bake it into the app.
#
# LICENSE_SIGNING_SECRET — legacy HS256 alternative: the same
# secret must be known to the license server AND baked into the
# desktop build. Use LICENSE_PUBLIC_KEY instead for customer
# builds (nothing secret ever ships in the installer).
#
# LICENSE_ALLOW_SELF_ISSUE — set to "true" only for self-hosted
# builds (so the user can mint their own key without contacting
# your server). MUST be "false" in distributed builds.
LICENSE_REQUIRED=""
LICENSE_API_BASE="https://license.nexoraosp.com"
LICENSE_PUBLIC_KEY=""
LICENSE_SIGNING_SECRET=""
LICENSE_ALLOW_SELF_ISSUE=""

# LICENSE_TRIAL_DAYS — auto-mint a free trial of N days on first
# launch of a distributed build. Set to 0 to disable the trial
# (customers must enter a key immediately).
LICENSE_TRIAL_DAYS="14"

# Optional WhatsApp notification gateway. Orders are recorded even if omitted.
WHATSAPP_PHONE_NUMBER="+919876543210"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
