# ─────────────────────────────────────────────────────────────
# Nagori Chai Point — configuration
# No Supabase, no Firebase, no cloud services. The app is fully
# self-contained and needs only the admin password below.
# ─────────────────────────────────────────────────────────────

# Single Admin Login
# ------------
# This is the ONE admin password. On the very first start the app
# saves it (hashed) to data/admin.json; after that the saved value
# is used, and you can change it from Admin → Café Settings →
# Update Password (takes effect immediately).
ADMIN_PASSWORD="9852120609@"
ADMIN_EMAIL="admin@nagoritea.com"

# Optional: stable key for admin session tokens (min 16 chars). If
# empty, a key is derived automatically and sessions survive restarts.
ADMIN_SESSION_SECRET=""

# Persistence
# ------------
# Strongly recommended (required in production). If set, ALL menu items,
# orders, feedbacks, tables, categories and settings are stored in your own
# PostgreSQL database through a single shared connection pool — the local JSON
# file is never touched.
#   direct:     postgresql://postgres:PASSWORD@host:5432/restaurant
DATABASE_URL=""
DIRECT_URL=""

# If DATABASE_URL is set but the database is unreachable, should the app fall
# back to data/restaurant.json?
#
#   production (VERCEL / NODE_ENV=production): defaults to FALSE.
#       The app FAILS LOUDLY — every data request returns
#       503 POSTGRES_UNAVAILABLE with a hint, and nothing is read or written.
#       There is no local fallback on purpose: serverless instances do not
#       share /tmp, so a local file would show each visitor a different copy of
#       the menu/orders and lose it on the next cold start.
#   local development: defaults to TRUE, and the fallback is logged at ERROR
#       level with the reason and the fix — never silently.
#
# Set explicitly to force either behaviour (e.g. "false" locally to rehearse an
# outage, or "true" in production to restore the old always-on file fallback).
ALLOW_LOCAL_FILE_FALLBACK=""

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# Optional WhatsApp notification gateway. Orders are recorded even if omitted.
WHATSAPP_PHONE_NUMBER="+919876543210"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
