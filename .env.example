# PostgreSQL (used when the Supabase API keys below are not set)
# Supabase Dashboard → Project Settings → Database. Password chars like @
# must be percent-encoded (@ → %40). The pooler path is IPv4-only.
#   direct:     postgresql://postgres:PASSWORD%40...@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#   pooler:     postgresql://postgres:PASSWORD%40...@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=""
DIRECT_URL=""

# Supabase (optional API layer: Realtime, Storage, Supabase Auth admin login)
# Find these in Supabase Dashboard → Project Settings → API.
# Classic key names and the new-style key names both work.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-or-publishable-key"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
SUPABASE_SECRET_KEY="your-server-only-secret-key"
# Optional: used if you verify admin JWTs locally instead of the /auth/v1/user API.
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# These VITE_ values are safe to expose to the browser and are used by Supabase Realtime.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Admin Auth
# Create this user in Supabase Dashboard → Authentication → Users.
ADMIN_EMAIL="admin@nagoritea.com"
ADMIN_PASSWORD="change-this-in-supabase-auth"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional WhatsApp notification gateway. Orders are recorded even if omitted.
WHATSAPP_PHONE_NUMBER="+919876543210"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
