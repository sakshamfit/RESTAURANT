{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.cjs" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.cjs": {
      "maxDuration": 60,
      "includeFiles": "../db/schema.sql"
    }
  }
}
